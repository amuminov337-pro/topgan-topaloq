# Nusxa oling: .env.example -> .env.local
# .env.local hech qachon git'ga qo'shilmaydi.

# Google Gemini API kaliti — faqat server tomonda ishlatiladi (F3).
# Nom @google/genai kutubxonasining o'zi tan oladigan rasmiy o'zgaruvchi (GOOGLE_API_KEY).
# Olish: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Ishlatiladigan model (F3 da o'qiladi)
GEMINI_MODEL=gemini-3.1-flash-lite
